# Configure these in Netlify's site environment settings. Never commit real values.
SITE_URL=https://your-site.netlify.app
APP_ORIGIN=https://your-site.netlify.app
NEXTAUTH_URL=https://your-site.netlify.app
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_SSL=require
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
NEXTAUTH_SECRET=replace-with-a-different-unique-random-secret-at-least-32-characters
ADMIN_EMAIL_WHITELIST=owner@example.com
CRON_SECRET=replace-with-another-unique-random-secret

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GA_ID=
